{
  "experiment_name": "cnn_scratch_tiny_from_random_initialization",
  "status": "locked_before_training",
  "task": "six_class_whole_image_classification",
  "model": {
    "name": "ScratchTinyCNN",
    "input_channels": 3,
    "channels": [16, 32, 64, 128],
    "conv_kernel": 3,
    "pool": "maxpool_2x2_after_each_block",
    "global_pool": "adaptive_average_pool_1x1",
    "dropout": 0.3,
    "initialization": "random_torch_initialization",
    "pretrained_weights": false
  },
  "num_classes": 6,
  "class_order": [
    "geometric",
    "animal",
    "antique object",
    "plant",
    "Chinese character",
    "combined"
  ],
  "split": {
    "train": 434,
    "validation": 93,
    "test": 93,
    "manifest": "data/splits.json",
    "reuse_existing_fixed_split": true
  },
  "image_size": 224,
  "resize_policy": "preserve_aspect_ratio_then_center_pad_white",
  "train_augmentation": {
    "random_affine_degrees": 5.0,
    "random_affine_translate": [0.05, 0.05],
    "random_affine_scale": [0.95, 1.05],
    "affine_fill_rgb": [255, 255, 255],
    "brightness_jitter": 0.1,
    "contrast_jitter": 0.1,
    "horizontal_flip": false,
    "random_resized_crop": false
  },
  "normalization": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.001,
  "class_weighting": "none",
  "label_smoothing": 0.0,
  "scheduler": "CosineAnnealingLR",
  "batch_size": 16,
  "max_epochs": 50,
  "early_stopping_patience": 10,
  "selection_metric": "validation_macro_f1",
  "development_seed": 42,
  "confirmatory_seeds": [42, 43, 44, 45, 46],
  "test_policy": "locked_until_model_and_hyperparameters_are_selected_on_validation",
  "allow_test_during_training": false,
  "allow_parameter_updates_in_smoke_test": false,
  "allow_tf32": false,
  "notes": "This is a validation-only from-scratch CNN baseline. It intentionally uses the same audited split, 224-pixel white padding, normalization, and mild augmentation as the ConvNeXt CNN protocol. No ImageNet or other pretrained weights are loaded."
}
